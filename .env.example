# ============================================================================
# Tahseen Jaber Cold Storage & Logistics — environment template
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored. NEVER commit real credentials.
# NEVER expose DATABASE_URL to the browser (only server code may read it).
#
# SECURITY NOTE (§03): if a database credential was ever pasted into a spec,
# chat message, ticket, or committed file, ROTATE / REVOKE it before deploying.
# Treat any credential that has left the secret manager as compromised.
# ============================================================================

# --- Public site -------------------------------------------------------------
# Absolute origin used for canonical URLs, sitemap, Open Graph and OAuth callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (SERVER ONLY — never prefixed with NEXT_PUBLIC_) ---------------
# PostgreSQL connection string. Leave empty to run the site in DEMO data mode.
# Example shape: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# --- Authentication (SERVER ONLY) -------------------------------------------
# Secret used to sign session tokens. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Session lifetime in seconds (default 604800 = 7 days)
AUTH_SESSION_MAX_AGE=604800

# Google OAuth — optional. Leave unset to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Notifications (SERVER ONLY) ---------------------------------------------
# SMTP transport for admin alerts. Leave unset to disable email notifications
# (inquiries are still recorded in the database).
# Example shape: smtp://user:pass@smtp.example.com:587
EMAIL_SERVER=
EMAIL_FROM=

# Where admin alerts are delivered.
ADMIN_NOTIFY_EMAIL=

# WhatsApp Business Cloud API — optional, for inquiry alerts.
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_RECIPIENT=

# --- Data source mode --------------------------------------------------------
# "demo"  -> simulated telemetry / inventory / security (UI is labelled SIMULATION)
# "live"  -> read from the real facility integrations (only once they exist)
# Never ship "live" unless real sensors are actually wired up (§40).
DATA_SOURCE_MODE=demo

# --- Abuse protection --------------------------------------------------------
# Public form rate limits (requests per hashed IP per window).
#
# Inquiries and logins get different budgets on purpose: a public form is spammed
# in bursts, while sign-in is attacked by slow credential guessing — so the useful
# defence there is a low ceiling over the same longer window.
RATE_LIMIT_WINDOW_SECONDS=600
RATE_LIMIT_MAX_INQUIRIES=5
RATE_LIMIT_MAX_LOGINS=8
RATE_LIMIT_MAX_ADMIN_WRITES=60
